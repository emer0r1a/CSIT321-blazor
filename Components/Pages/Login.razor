@page "/login"
@inject NavigationManager Navigation

<PageTitle>Hearthstone — Welcome back</PageTitle>
<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="page">
    <!-- LEFT: Hero image side -->
    <div class="hero">
        <span class="badge">Curated homes across premium neighborhoods</span>

        <div class="hero-bottom">
            <div class="hero-title">Discover Your<br>Next Home</div>
            <p class="hero-desc">Explore handpicked properties and welcoming neighborhoods, and take the next step in your journey with total peace of mind.</p>
            <div class="hero-pills">
                <span class="pill"><span class="icon-dot"></span>1,240 homes available</span>
                <span class="pill"><span class="icon-dot"></span>Top-rated agents nearby</span>
                <span class="pill"><span class="icon-dot"></span>New listings added daily</span>
            </div>
        </div>
    </div>

    <!-- RIGHT: Form side -->
    <div class="form-side">
        <div class="form-wrap">
            <div class="logo">
                <span class="logo-mark"></span>
                <a href="/">Hearthstone</a>
            </div>
            

            <h1 class="welcome">Welcome back</h1>
            <p class="subtext">Sign in to manage saved homes, schedule tours, and continue your search.</p>

            <div class="panel">
                <div class="field">
                    <label for="email">Email address</label>
                    <input type="email" id="email" placeholder="name@@email.com" />
                </div>
                <div class="field">
                    <label for="password">Password</label>
                    <input type="password" id="password" placeholder="Password" />
                </div>

                <button class="btn-signin">Sign In</button>

                <div class="forgot"><a href="#">Forgot password?</a></div>

                <div class="divider">
                    <span class="line"></span>
                    <span>or continue with</span>
                    <span class="line"></span>
                </div>

                <div class="social-row">
                    <button class="social-btn"><img src="images/email.png"/>Email</button>
                    <button class="social-btn"><img src="images/facebook.png"/>Facebook</button>
                </div>
            </div>

            <p class="signup-line">Don't have an account? <a href="/register">Sign up</a></p>
        </div>
    </div>
</div>
