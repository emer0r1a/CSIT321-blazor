@page "/login"
@rendermode InteractiveServer

<PageTitle>Hearthstone — Welcome back</PageTitle>

<AuthLayout HeroTitle1="Discover your" HeroTitle2="next home"
            HeroText="Explore handpicked properties and welcoming neighborhoods, and take the next step in your journey with total peace of mind."
            Title="Welcome back"
            Subtitle="Sign in to manage saved homes, schedule tours, and continue your search."
            SocialLabel="or continue with" ShowSocial="@(!done)">
    <ChildContent>
        @if (done)
        {
            <div class="py-6 text-center" role="status">
                <span class="mx-auto grid size-14 place-items-center rounded-full bg-[#241812] text-white"><Icon Name="check" Class="size-7" /></span>
                <h2 class="mt-4 text-xl font-extrabold">You're signed in</h2>
                <p class="mt-1.5 text-sm font-medium text-[#6b5d52]">Good to see you again, @email.</p>
                <a href="/" class="@Ui.BtnDark mt-6">Continue searching</a>
            </div>
        }
        else
        {
            <form @onsubmit="Submit" novalidate>
                <FormField Id="email" Label="Email address" Type="email" Placeholder="@("name@email.com")" Autocomplete="email" @bind-Value="email" Error="@Err("email")" />
                <FormField Id="password" Label="Password" Type="password" Placeholder="Password" Autocomplete="current-password" @bind-Value="pw" Error="@Err("pw")" />

                <button type="submit" class="@Ui.BtnDarkLg w-full">Sign in</button>
                <div class="mt-4 text-center text-[13px] font-semibold"><a href="#" class="hover:text-[#c8703a]">Forgot password?</a></div>
            </form>
        }
    </ChildContent>
    <Footer>Don't have an account? <a class="font-bold text-[#c8703a] hover:underline" href="/register">Sign up</a></Footer>
</AuthLayout>

@code {
    string email = "", pw = "";
    bool done;
    readonly Dictionary<string, string> errors = new();

    string? Err(string key) => errors.GetValueOrDefault(key);

    void Submit()
    {
        errors.Clear();
        if (!Ui.IsEmail(email)) errors["email"] = "Enter a valid email address.";
        if (string.IsNullOrEmpty(pw)) errors["pw"] = "Enter your password.";

        // TODO: call your sign-in service here when errors.Count == 0
        done = errors.Count == 0;
    }
}
