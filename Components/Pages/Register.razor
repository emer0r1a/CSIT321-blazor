@page "/register"
@rendermode InteractiveServer

<PageTitle>Hearthstone — Create your account</PageTitle>

<AuthLayout HeroTitle1="Start your" HeroTitle2="journey home"
            HeroText="Create your Hearthstone account to save listings, explore neighborhoods, and move closer to the home you've been imagining."
            Title="Create your account"
            Subtitle="Join Hearthstone to save homes, track neighborhoods, and stay updated on your move."
            SocialLabel="or sign up with" ShowSocial="@(!done)">
    <ChildContent>
        @if (done)
        {
            <div class="py-6 text-center" role="status">
                <span class="mx-auto grid size-14 place-items-center rounded-full bg-[#241812] text-white"><Icon Name="check" Class="size-7" /></span>
                <h2 class="mt-4 text-xl font-extrabold">Welcome, @(name.Trim().Split(' ')[0])!</h2>
                <p class="mt-1.5 text-sm font-medium text-[#6b5d52]">Your account is ready. Start saving homes you love.</p>
                <a href="/" class="@Ui.BtnDark mt-6">Start browsing</a>
            </div>
        }
        else
        {
            <form @onsubmit="Submit" novalidate>
                <FormField Id="fullname" Label="Full name" Placeholder="Jane Doe" Autocomplete="name" @bind-Value="name" Error="@Err("name")" />
                <FormField Id="email" Label="Email address" Type="email" Placeholder="@("name@email.com")" Autocomplete="email" @bind-Value="email" Error="@Err("email")" />
                <FormField Id="phone" Label="Phone number" Type="tel" Placeholder="(555) 123-4567" Autocomplete="tel" @bind-Value="phone" />
                <FormField Id="password" Label="Password" Type="password" Placeholder="At least 8 characters" Autocomplete="new-password" @bind-Value="pw" Error="@Err("pw")" />
                <FormField Id="confirm-password" Label="Confirm password" Type="password" Placeholder="Confirm password" Autocomplete="new-password" @bind-Value="pw2" Error="@Err("pw2")" />

                <label class="flex cursor-pointer items-start gap-2.5">
                    <input type="checkbox" @bind="agree" class="@Ui.Check" />
                    <span class="text-[13px] font-medium leading-normal">I agree to the <a class="font-bold underline-offset-2 hover:underline" href="#">Terms of Service</a> and <a class="font-bold underline-offset-2 hover:underline" href="#">Privacy Policy</a>.</span>
                </label>
                @if (Err("agree") is { } agreeError)
                {
                    <p class="mt-1.5 text-[12.5px] font-medium text-red-700" role="alert">@agreeError</p>
                }

                <button type="submit" class="@Ui.BtnDarkLg mt-5 w-full">Create account</button>
            </form>
        }
    </ChildContent>
    <Footer>Already have an account? <a class="font-bold text-[#c8703a] hover:underline" href="/login">Sign in</a></Footer>
</AuthLayout>

@code {
    string name = "", email = "", phone = "", pw = "", pw2 = "";
    bool agree, done;
    readonly Dictionary<string, string> errors = new();

    string? Err(string key) => errors.GetValueOrDefault(key);

    void Submit()
    {
        errors.Clear();
        if (string.IsNullOrWhiteSpace(name)) errors["name"] = "Enter your full name.";
        if (!Ui.IsEmail(email)) errors["email"] = "Enter a valid email address.";
        if (pw.Length < 8) errors["pw"] = "Use at least 8 characters.";
        if (pw2 != pw) errors["pw2"] = "Passwords don't match.";
        if (!agree) errors["agree"] = "Accept the terms to continue.";

        // TODO: call your registration service here when errors.Count == 0
        done = errors.Count == 0;
    }
}
