      <div class="testimonial-card">
        <div class="testimonial-img"><img src="images/img4.png" alt="Dream Home" /></div>
        <div class="testimonial-body">
          <div class="t-user-row">
            <div class="avatar"><div class="ph-img"></div></div>
            <div class="t-user-info">
              <div class="t-name">Michael Rodriguez</div>
              <div class="t-loc">San Diego</div>
            </div>
            <div class="t-rating">★ 4.5</div>
