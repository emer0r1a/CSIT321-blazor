@page "/"
@inject NavigationManager Navigation

<PageTitle>Hearthstone — Find Your Dream Home</PageTitle>
<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="home-page">

<!-- ===================== HEADER ===================== -->
<header>
  <div class="wrap nav">
    <div class="logo"><span class="logo-mark"></span>Hearthstone</div>
    <nav class="nav-links">
      <a href="#">Home</a>
      <a href="#">Service</a>
      <a href="#">Agents</a>
      <a href="#">Contact</a>
    </nav>
    <div class="nav-right">
      <span class="nav-icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </span>
      <span class="nav-icon-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
      </span>
      <a href="/register" class="btn btn-dark">Sign up</a>
    </div>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="hero-section">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <h1 class="hero-title">Find Your<br>Dream Home</h1>
        <p class="hero-desc">Discover modern houses, family estates, and sunlit retreats designed for the way you want to live.</p>
        <a href="/register" class="btn btn-dark">Sign up</a>
      </div>
      <div class="hero-img-wrap"><img src="images/img1.png"/></div>
    </div>

    <div class="search-bar">
      <div class="search-field">Location
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
      </div>
      <div class="search-field">Type
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>
      </div>
      <div class="search-field">Price Range
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M15 9.5c0-1.4-1.4-2.5-3-2.5s-3 1.1-3 2.5 1.4 2.5 3 2.5 3 1.1 3 2.5-1.4 2.5-3 2.5-3-1.1-3-2.5"/></svg></span>
      </div>
      <a href="/register" class="btn btn-dark">Sign up</a>
    </div>
  </div>
</section>

<!-- ===================== INTRO / STATS ===================== -->
<section class="intro-section">
  <div class="wrap intro-grid">
    <div class="intro-img"><img src="images/img2.png" alt="Dream Home" /></div>
    <div>
      <h2 class="intro-title">We Help You To Find<br>Your Dream Home</h2>
      <p class="intro-desc">From cozy cottages to luxurious estates, our dedicated team guides you through every step of the journey, ensuring your dream home becomes a reality</p>
      <div class="stats-row">
        <div>
          <div class="stat-num">8K+</div>
          <div class="stat-label">Houses Available</div>
        </div>
        <div>
          <div class="stat-num">6K+</div>
          <div class="stat-label">Houses Sold</div>
        </div>
        <div>
          <div class="stat-num">2K+</div>
          <div class="stat-label">Trusted Agents</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===================== WHY CHOOSE US ===================== -->
<section class="why-section">
  <div class="wrap">
    <h2 class="why-title">Why Choose Us</h2>
    <p class="why-desc">Elevating Your Home Buying Experience with Expertise, Integrity, and Unmatched Personalized Service</p>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-icon"><img src="images/map pin.png" alt="Dream Home" /></div>
        <h3>Expert Guidance</h3>
        <p>Benefit from our team's seasoned expertise for a smooth buying experience</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><img src="images/service.png" alt="Dream Home" /></div>
        <h3>Personalized Service</h3>
        <p>Our services adapt to your unique needs, making your journey stress-free</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><img src="images/document.png" alt="Dream Home" /></div>
        <h3>Transparent Process</h3>
        <p>Stay informed with our clear and honest approach to buying your home</p>
      </div>
      <div class="why-card">
        <div class="why-icon"><img src="images/user.png" alt="Dream Home" /></div>
        <h3>Exceptional Support</h3>
        <p>Providing peace of mind with our responsive and attentive customer service</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== FEATURED LISTINGS ===================== -->
<section class="listings-section">
  <div class="wrap">
    <div class="listings-head">
      <div>
        <div class="eyebrow">FEATURED LISTINGS</div>
        <h2 class="listings-title">Handpicked homes with character, comfort, and space to grow</h2>
        <p class="listings-desc">From sun-drenched family houses to refined modern retreats, these featured properties are designed to feel like home from day one.</p>
      </div>
      <button class="btn btn-outline">View all listings</button>
    </div>

    <div class="listings-grid">
      <div class="listing-card">
        <div class="listing-img-wrap"><img src="images/img3.png" alt="Dream Home" /><span class="listing-tag">Price drop</span></div>
        <div class="listing-body">
          <div class="listing-location">
            <span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            San Francisco, California
          </div>
          <div class="listing-meta">
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>4 Rooms</span>
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></span>3,500 sq ft</span>
          </div>
          <div class="listing-foot">
            <a href="/register" class="btn btn-dark">Sign up</a>
            <div class="listing-price">$2,500,000</div>
          </div>
        </div>
      </div>

      <div class="listing-card">
        <div class="listing-img-wrap"><img src="images/img3.png" alt="Dream Home" /><span class="listing-tag">Open House</span></div>
        <div class="listing-body">
          <div class="listing-location">
            <span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            Beverly Hills, California
          </div>
          <div class="listing-meta">
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>3 Rooms</span>
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></span>1,500 sq ft</span>
          </div>
          <div class="listing-foot">
            <a href="/register" class="btn btn-dark">Sign up</a>
            <div class="listing-price">$850,000</div>
          </div>
        </div>
      </div>

      <div class="listing-card">
        <div class="listing-img-wrap"><img src="images/img3.png" alt="Dream Home" /><span class="listing-tag">Price drop</span></div>
        <div class="listing-body">
          <div class="listing-location">
            <span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            Palo Alto, California
          </div>
          <div class="listing-meta">
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>6 Rooms</span>
            <span><span class="icon" style="width:15px;height:15px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></span>4,000 sq ft</span>
          </div>
          <div class="listing-foot">
            <a href="/register" class="btn btn-dark">Sign up</a>
            <div class="listing-price">$3,700,000</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

